# Django Settings
DEBUG=True
SECRET_KEY=your-secret-key-change-in-production

# Database (using SQLite by default)
DATABASE_URL=sqlite:///db.sqlite3

# Allowed Hosts (comma-separated)
ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.com.ng

# Email Configuration (optional, for contact forms)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

# Company Settings
COMPANY_NAME=DE-GREAT WELD ENTERPRISES
COMPANY_EMAIL=info@degreatwelds.com
COMPANY_PHONE=+234-XXX-XXX-XXXX
COMPANY_WHATSAPP=+234XXXXXXXXXX
COMPANY_ADDRESS=Ikorodu, Lagos State, Nigeria

# Google Analytics (optional)
GOOGLE_ANALYTICS_ID=

# Security Settings (for production)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
